{
  "name": "expo-starter",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "description": "Open-source Expo + React Native app starter: onboarding, sign-in and paywall screens, theming, i18n, deep links, component gallery",
  "license": "MIT",
  "author": {
    "name": "SoarStarter",
    "url": "https://soarstarter.com"
  },
  "homepage": "https://github.com/soarstarter/expo-starter",
  "repository": {
    "type": "git",
    "url": "https://github.com/soarstarter/expo-starter"
  },
  "bugs": {
    "url": "https://github.com/soarstarter/expo-starter/issues"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "expo start -c -p 3000",
    "android": "expo start -c --android",
    "ios": "expo start -c --ios",
    "web": "expo start -c --web",
    "clean": "rm -rf .expo node_modules",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "expo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "check:lite": "node scripts/check-lite.mjs",
    "generate:assets": "node scripts/generate-assets.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "~58.0.17",
    "@gorhom/bottom-sheet": "^5.2.12",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@rn-primitives/dialog": "^1.5.2",
    "@rn-primitives/label": "^1.5.2",
    "@rn-primitives/portal": "~1.5.3",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-haptics": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-store-review": "~58.0.3",
    "expo-system-ui": "~58.0.7",
    "expo-tracking-transparency": "~58.1.0",
    "i18n-js": "^4.5.2",
    "lucide-react-native": "^0.545.0",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.74.0",
    "react-native": "0.88.1",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^58.0.4",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sharp": "^0.34.5",
    "test-renderer": "1.3.0",
    "typescript": "~6.0.3"
  }
}
