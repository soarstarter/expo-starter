# Optional. The app runs without a `.env` file; copy this file to `.env.local` only if you
# need one of these. Only `EXPO_PUBLIC_*` vars are inlined into the JS bundle.

# `LINKING_DOMAIN` enables Universal Links / App Links when your domain hosts
# the required apple-app-site-association and assetlinks.json files.
EXPO_PUBLIC_LINKING_DOMAIN=

# Store pages, used by expo-store-review when the in-app rating prompt is unavailable.
EXPO_PUBLIC_APP_STORE_URL=
EXPO_PUBLIC_PLAY_STORE_URL=

# Hosted copies of the legal documents, linked from the legal and paywall screens.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_EULA_URL=
